{
  "name": "caduceus",
  "version": "1.0.0",
  "description": "An open coding agent that runs on Ollama Cloud — CLI, TUI, and web UI with skills, knowledge, memory, MCP, subagents, and prompt compression.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "ollama",
    "llm",
    "mcp",
    "cli",
    "tui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Venkataraman T S K",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TSKVenkat/caduceus.git"
  },
  "homepage": "https://github.com/TSKVenkat/caduceus#readme",
  "bin": {
    "caduceus": "./dist/cli.js",
    "caduceus-web": "./dist/web/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "tsx src/web/cli.ts",
    "compress": "tsx src/compress/cli.ts",
    "measure:compress": "tsx src/compress/measure.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "^7.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "hono": "^4.12.26",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
